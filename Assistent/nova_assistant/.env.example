# AI provider configuration
# Gemini is the default. Store your own key only in your local .env file.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# Optional local provider
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Speech recognition
# google is the easiest first setup and needs internet.
# vosk is offline, but needs a compatible model downloaded separately.
STT_PROVIDER=google
VOSK_MODEL_PATH=
STT_LANGUAGE=en-IN
LISTEN_SECONDS=5
WAKE_WORD=hey nova

# Text-to-speech
# pyttsx3 uses the Windows SAPI voices installed on the laptop.
TTS_ENGINE=pyttsx3
TTS_VOICE_NAME=
TTS_RATE=175
TTS_VOLUME=1.0

# Assistant identity and local files
ASSISTANT_NAME=Nova
TEXT_FILE_FOLDER=
SCREENSHOT_FOLDER=
MAX_MEMORY_TURNS=12